# Same DB as store-smt
DATABASE_URL="sqlserver://localhost:1433;database=Warehouse_F5;user=sa;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"
JWT_SECRET="must-match-store-smt-JWT_SECRET"
NODE_ENV="development"

# PBASS pull (invoice list sync — POST /api/inbound-tasks/sync)
PBASS_INVOICE_API_URL=
PBASS_STOCK_API_TOKEN=
PBASS_API_TIMEOUT=30000
PBASS_API_IGNORE_SSL=true
HTTPS_PROXY=

# Optional: external IQC system notified on receive (non-blocking)
IQC_SYSTEM_URL="http://localhost:3060"
